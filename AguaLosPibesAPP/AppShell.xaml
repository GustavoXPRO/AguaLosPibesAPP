<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="AguaLosPibesAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AguaLosPibesAPP"
    Shell.FlyoutBehavior="Flyout"
    Title="AguaLosPibesAPP">

    <!-- Pantalla de Login (Oculta del menú lateral y sin barra) -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage"
        Shell.FlyoutItemIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <!-- 1. Pantalla de Inicio (Visible en el menú y con las 3 rayitas activas) -->
    <FlyoutItem Title="Inicio" Icon="logo.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:InicioPage}"
            Route="InicioPage" />
    </FlyoutItem>

    <!-- 2. Opciones de Entrega -->
    <FlyoutItem Title="Opciones de Entrega" Icon="entrega.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:EntregaPage}"
            Route="EntregaPage" />
    </FlyoutItem>

    <!-- 3. Mi Perfil -->
    <FlyoutItem Title="Mi Perfil" Icon="perfil.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:PerfilPage}"
            Route="PerfilPage" />
    </FlyoutItem>

    <!-- 4. Historial de Compras -->
    <FlyoutItem Title="Historial de Compras" Icon="historial.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:HistorialPage}"
            Route="HistorialPage" />
    </FlyoutItem>

    <!-- Acciones Rápidas del Menú Lateral -->
    <MenuItem Text="Ayuda / Soporte (WhatsApp)"
              Clicked="OnAyudaWhatsAppClicked" />

    <MenuItem Text="Cerrar Sesión"
              Clicked="OnCerrarSesionClicked" />

</Shell>
    