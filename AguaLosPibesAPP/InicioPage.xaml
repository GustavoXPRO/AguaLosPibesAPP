<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AguaLosPibesAPP.InicioPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Título Principal Centrado -->
            <Label Text="AGUA LOS PIBES"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#1A365D"
                   HorizontalOptions="Center"
                   Margin="0,15,0,0" />

            <!-- Logo Principal -->
            <Image Source="logo.png"
                   HeightRequest="90"
                   WidthRequest="90"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   Margin="0,-5,0,5" />

            <!-- Subtítulo -->
            <Label Text="¡Hola! Seleccioná un servicio:"
                   FontSize="14"
                   TextColor="#555555"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,5" />

            <!-- Opción 1: Recarga de Agua -->
            <Border Stroke="#00A8E8" StrokeThickness="2" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recarga de Agua (20L) - $5.000" FontSize="16" FontAttributes="Bold" TextColor="#00A8E8" />
                    <Button Text="Solicitar Recarga" 
                            BackgroundColor="#00A8E8" 
                            TextColor="White"
                            HeightRequest="45"
                            CornerRadius="10"
                            Clicked="OnRecargaClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Opción 2: Compra Inicial -->
            <Border Stroke="#0077B6" StrokeThickness="2" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Kit Envase + Carga (20L) - $20.000" FontSize="16" FontAttributes="Bold" TextColor="#0077B6" />
                    <Button Text="Comprar Kit Nuevo" 
                            BackgroundColor="#0077B6" 
                            TextColor="White"
                            HeightRequest="45"
                            CornerRadius="10"
                            Clicked="OnCompraInicialClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Opción 3: Solicitud de Dispenser -->
            <Border Stroke="#023E8A" StrokeThickness="2" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Solicitar Dispenser - $15.000" FontSize="16" FontAttributes="Bold" TextColor="#023E8A" />
                    <Button Text="Solicitar Dispenser" 
                            BackgroundColor="#023E8A" 
                            TextColor="White"
                            HeightRequest="45"
                            CornerRadius="10"
                            Clicked="OnDispenserClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- SECCIÓN NUEVA: BARRA DE BOTONES ABAJO DE LOS SERVICIOS -->
            <BoxView HeightRequest="1" BackgroundColor="#CCCCCC" Margin="0,10,0,10" />

            <Label Text="Menú de Navegación" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="#1A365D" 
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" RowDefinitions="Auto, Auto" RowSpacing="10">

                <!-- Botón Perfil -->
                <Button Grid.Row="0" Grid.Column="0"
                        Text="👤 Mi Perfil" 
                        BackgroundColor="#4A5568" 
                        TextColor="White" 
                        CornerRadius="8"
                        Clicked="OnPerfilClicked" />

                <!-- Botón Historial -->
                <Button Grid.Row="0" Grid.Column="1"
                        Text="📋 Historial" 
                        BackgroundColor="#4A5568" 
                        TextColor="White" 
                        CornerRadius="8"
                        Clicked="OnHistorialClicked" />

                <!-- Botón WhatsApp -->
                <Button Grid.Row="1" Grid.Column="0"
                        Text="💬 Soporte WA" 
                        BackgroundColor="#25D366" 
                        TextColor="White" 
                        CornerRadius="8"
                        Clicked="OnAyudaWhatsAppClicked" />

                <!-- Botón Cerrar Sesión -->
                <Button Grid.Row="1" Grid.Column="1"
                        Text="🚪 Salir" 
                        BackgroundColor="#D90429" 
                        TextColor="White" 
                        CornerRadius="8"
                        Clicked="OnCerrarSesionClicked" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>