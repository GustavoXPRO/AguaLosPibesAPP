<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AguaLosPibesAPP.ConfirmacionPage"
             Title="Resumen de Pedido"
             BackgroundColor="#F4F7F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado de Éxito / Confirmación -->
            <Image Source="logo.png" 
                   HeightRequest="90" 
                   HorizontalOptions="Center" />

            <Label Text="¡Casi listo!"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#1A365D"
                   HorizontalOptions="Center" />

            <Label Text="Revisa los detalles de tu pedido antes de confirmar:"
                   FontSize="14"
                   TextColor="#555555"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Tarjeta con el Resumen -->
            <Border BackgroundColor="White" Stroke="#00A8E8" StrokeThickness="2" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <!-- Detalle del Producto -->
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Producto Solicitado:" FontSize="12" TextColor="#888888" />
                        <Label x:Name="lblProductoConfirmado" FontSize="16" FontAttributes="Bold" TextColor="#1A365D" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E5E7EB" />

                    <!-- Detalle de la Entrega -->
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Modalidad de Entrega:" FontSize="12" TextColor="#888888" />
                        <Label x:Name="lblEntregaConfirmada" FontSize="16" FontAttributes="Bold" TextColor="#0284C7" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#E5E7EB" />

                    <!-- Nota Informativa -->
                    <Label Text="✅ Tu pedido ingresará directamente al sistema de preparación."
                           FontSize="12"
                           TextColor="#16A34A"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <Button Text=" Confirmar Pedido" 
                        BackgroundColor="#16A34A" 
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Clicked="OnConfirmarPedidoClicked" />

                <Button Text="Volver al Inicio" 
                        BackgroundColor="Transparent" 
                        TextColor="#E11D48"
                        FontSize="14"
                        Clicked="OnVolverInicioClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>